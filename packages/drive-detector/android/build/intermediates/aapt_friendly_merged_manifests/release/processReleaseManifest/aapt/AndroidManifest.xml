<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="sk.faktero.drivedetector" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
      Poloha na pozadí je jadro celej veci: jazda sa má zapísať aj vtedy, keď
      má človek telefón vo vrecku. Google Play si to pri odovzdaní vyžiada
      obhájiť formulárom aj videom — bez toho appku nezverejní.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Rozpoznanie jazdy autom. Nepovinné — bez neho sa len dlhšie drží prah. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      Bez služby v popredí systém meranie po pár minútach zastaví. Od Androidu
      14 treba aj typ služby, inak sa štart odmietne výnimkou.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rozpracovaná jazda musí po reštarte telefónu pokračovať. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="sk.faktero.drivedetector.DriveDetectorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Tri tlačidlá v notifikácii. Musia fungovať, aj keď appka nebeží. -->
        <receiver
            android:name="sk.faktero.drivedetector.DriveActionReceiver"
            android:exported="false" />
        <receiver
            android:name="sk.faktero.drivedetector.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>